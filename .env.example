# Copy to `.env` at the repo root. docker-compose reads it for `${VAR}`
# substitution; local uvicorn finds it through Settings(env_file=(".env", "../.env")).
# Every key here has a matching field in backend/app/config.py and a line in
# docker-compose.yml's environment allowlist.

PROJECT_NAME=HR Scout
MONGO_DB=app

# --- AI: direct Anthropic API ---------------------------------------------
# Required for scraping and the interview coach. Create one at
# https://platform.claude.com. Without it the backend starts, /api/health
# reports llm.configured=false, and the first AI call fails with a clear error.
ANTHROPIC_API_KEY=
# Model for extraction and chat. claude-opus-5-5 is the default; set
# claude-sonnet-5-5 for lower cost on high-volume scraping.
AI_MODEL=claude-opus-5-5
# Reasoning depth on Claude 4.6+ models: low | medium | high | xhigh | max.
# Leave empty to omit the parameter for a model that rejects it.
AI_EFFORT=medium
# Re-run a request the model declines on Anthropic's recommended fallback
# model (server-side, same call). Set false to receive refusals as errors.
AI_REFUSAL_FALLBACK=true
EXTRACT_MAX_TOKENS=16000
CHAT_MAX_TOKENS=4096

# --- Scraping caps (characters of page text sent to the model) ------------
SCRAPE_PAGE_CHARS=12000
APIFY_TEXT_CHARS=15000
# Optional server-side Apify token; a token typed into the UI takes precedence.
APIFY_API_KEY=

# --- Secrets vault --------------------------------------------------------
# Passphrase the vault's encryption key is derived from. Empty disables the
# Secrets tab (503). Changing it makes previously stored secrets unreadable.
SECRETS_ENCRYPTION_KEY=

# --- HTTP -----------------------------------------------------------------
# Comma-separated browser origins allowed cross-origin, e.g. http://localhost:3000.
# Empty: no CORS middleware (the Vite dev server proxies /api same-origin).
CORS_ORIGINS=
SCHEDULER_TICK_SECONDS=60

# Host ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
